# =============================================================================
# Environment Secrets - STAGING
# =============================================================================
# SETUP:
#   1. Copy this file to .env.staging (in this directory)
#   2. Fill in the actual secret values
#   3. Run: make -C infra/fly secrets ENV=staging
#
# ⚠️  NEVER commit .env.staging to version control!
# =============================================================================

# Database (MongoDB Atlas)
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/billie-servicing

# Redis (Upstash)
REDIS_URL=redis://default:password@host.upstash.io:6379

# Payload CMS
PAYLOAD_SECRET=your-secret-key-change-in-production

# -----------------------------------------------------------------------------
# Reporting (BTB-503) — see docs/reporting.md
# -----------------------------------------------------------------------------

# Report runner connection. Every report, Ask Claude preview and MCP query runs
# through this, never through DATABASE_URI. The Neon READ REPLICA of this
# environment's CRM database, logged in as the reporting_reader role (it can
# read only the `reporting` schema). Use the replica's direct endpoint (not
# -pooler). Required: without it, Reports says "Reporting is not configured".
REPORTING_DATABASE_URI=postgresql://reporting_reader:<pwd>@ep-<replica>.ap-southeast-2.aws.neon.tech/billie_crm?sslmode=verify-full

# Bearer token for the scheduled jobs (/api/reports/jobs/*: the Monday email
# and the nightly portfolio snapshot). Long random string, e.g.
# `openssl rand -hex 32`; a different value per environment. Unset = jobs refused.
# (The scheduled-reports workflow only calls demo and prod; set it here to
# call the jobs by hand.)
REPORTING_JOB_TOKEN=change-me

# Resend API key for the Monday report email to supervisors (sent directly,
# not through Payload's email adapter). Unset = the email job refuses to run.
RESEND_API_KEY=re_xxxxxxxx
# Optional sender; defaults to noreply@billie.loans (the verified sender).
# RESEND_FROM_ADDRESS=noreply@billie.loans

# Marks non-prod report emails so they are not mistaken for real figures:
# "DEMO" puts "[DEMO]" in the subject and "DEMO environment, not production
# data." at the top of the email.
REPORTS_EMAIL_LABEL=STAGING

# Slack incoming webhook for report emails and alerts that report authors
# send to a shared channel ("Email me this" > "The Slack channel"). The
# webhook names the channel. Unset = Slack is not offered.
# REPORTS_SLACK_WEBHOOK_URL=

# Anthropic API key for "Ask Claude for a report" (drafts report SQL from the
# schema description; never sends result rows). Unset = the Ask panel says it
# is not configured; the rest of Reports still works.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: extra OAuth redirect URIs the reporting MCP connector accepts, exact and
# comma-separated, for MCP clients other than claude.ai/claude.com and local Claude Code
# (which are always allowed). Leave unset unless such a client needs it.
# MCP_OAUTH_REDIRECT_URIS=
